<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{#- Canonical origin for absolute URLs in share cards. OG/Twitter require
    absolute URLs -- relative paths are silently ignored by most scrapers. -#}
{%- set SITE_URL  = "https://secondadamnewcreations.com" -%}
{%- set SITE_NAME = "Second Adam & the New Creations" -%}

{#- page.url is relative to dir.output ("blog"), so it lacks the /blog
    segment. Prepend it to build the real public URL. -#}
{%- set PAGE_URL = SITE_URL + "/blog" + page.url -%}

{%- set OG_TITLE = title if title else SITE_NAME -%}
{#- Posts carry `excerpt` (that is the Decap field); the index and category
    pages carry `description`. Fall back through both, then to the site blurb. -#}
{%- set OG_DESC  = description if description else (excerpt if excerpt else "New writing on theology, music, and culture from Second Adam & the New Creations.") -%}
{%- set OG_TYPE  = ogType if ogType else "website" -%}
{#- A post's own image wins. Failing that, a YouTube video supplies a
    thumbnail. Anything still without one -- the blog index, the category
    pages, a text-only post, a Rumble post with no cover -- falls back to the
    site share image so every blog URL unfurls with a large card. -#}
{%- set OG_VIDEO = video | videoEmbed -%}
{%- set OG_FALLBACK = SITE_URL + "/site-img/og-sanc.jpg" -%}
{%- set OG_IMAGE = SITE_URL + image if image else (OG_VIDEO.thumb if OG_VIDEO and OG_VIDEO.thumb else OG_FALLBACK) -%}
{#- Only the fallback has known dimensions (1200x630); a post's own image or a
    YouTube thumbnail does not, so width/height are emitted only for it. -#}
{%- set OG_IMAGE_IS_FALLBACK = OG_IMAGE == OG_FALLBACK -%}

<title>{% if title %}{{ title }} &mdash; {{ SITE_NAME }}{% else %}{{ SITE_NAME }}{% endif %}</title>
<meta name="description" content="{{ OG_DESC }}">
<link rel="canonical" href="{{ PAGE_URL }}">

<!-- Open Graph -->
<meta property="og:site_name" content="{{ SITE_NAME }}">
<meta property="og:type" content="{{ OG_TYPE }}">
<meta property="og:title" content="{{ OG_TITLE }}">
<meta property="og:description" content="{{ OG_DESC }}">
<meta property="og:url" content="{{ PAGE_URL }}">
{%- if OG_IMAGE %}
<meta property="og:image" content="{{ OG_IMAGE }}">
<meta property="og:image:alt" content="{{ OG_TITLE }}">
{%- if OG_IMAGE_IS_FALLBACK %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- endif %}
{%- endif %}
{%- if OG_TYPE == "article" and date %}
<meta property="article:published_time" content="{{ date.toISOString() }}">
{%- endif %}

<!-- Twitter Card -->
<meta name="twitter:card" content="{% if OG_IMAGE %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ OG_TITLE }}">
<meta name="twitter:description" content="{{ OG_DESC }}">
{%- if OG_IMAGE %}
<meta name="twitter:image" content="{{ OG_IMAGE }}">
{%- endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Special+Elite&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=IM+Fell+English:ital@0;1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/blog/assets/blog.css">
<link rel="alternate" type="application/atom+xml" title="Second Adam &amp; the New Creations Blog" href="/blog/feed.xml">
</head>
<body>

<nav>
  <a class="nav-brand" href="/">
    <span class="nav-brand-logo">SANC</span>
    <span class="nav-brand-full">Second Adam &amp; the New Creations</span>
  </a>
  <ul class="nav-links">
    <li><a href="/#music">Music</a></li>
    <!-- Every page produced by this build lives under /blog, so Blog is always the active nav item. -->
    <li><a href="/blog" class="active">Blog</a></li>
    <li><a href="/#connect">Connect</a></li>
    <li><a href="/merch">Merch</a></li>
  </ul>
</nav>

<main class="blog-main">
{{ content | safe }}
</main>

<footer>
  <!-- Same destinations as index.html's #connect section. If that list changes,
       update it here too -- there is no shared include across the two. -->
  <div class="footer-social">
    <a href="https://open.spotify.com/artist/6xtc84WJH84h4D2CwfVB9e" target="_blank" rel="noopener">Spotify</a>
    <a href="https://music.apple.com/us/artist/second-adam-the-new-creations/975245379" target="_blank" rel="noopener">Apple Music</a>
    <a href="https://secondadamnewcreations.bandcamp.com" target="_blank" rel="noopener">Bandcamp</a>
    <a href="https://soundcloud.com/secondadamnewcreations" target="_blank" rel="noopener">SoundCloud</a>
    <a href="https://www.facebook.com/SecondAdamandtheNewCreations/" target="_blank" rel="noopener">Facebook</a>
    <a href="https://www.youtube.com/channel/UC_6oWltF9sMHT0SeILlD8kw" target="_blank" rel="noopener">YouTube</a>
    <a href="https://www.instagram.com/secondadam_nc" target="_blank" rel="noopener">Instagram</a>
    <a href="https://x.com/SecondAdam_NC" target="_blank" rel="noopener">X / Twitter</a>
  </div>
  <p>&copy; <span class="yr">2026</span> Second Adam &amp; the New Creations &mdash; All music &amp; writings by Abram Germano</p>
  <p>Poughkeepsie, New York &nbsp;&bull;&nbsp; #biblicalindierock</p>
</footer>

<script>(function(){var y=new Date().getFullYear();var e=document.querySelectorAll('.yr');for(var i=0;i<e.length;i++){e[i].textContent=y;}})();</script>
</body>
</html>
